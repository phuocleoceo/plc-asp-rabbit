<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>PlcRabbitLibrary</Title>
    <Authors>phuocleoceo</Authors>
    <Copyright>phuocleoceo</Copyright>
    <PackageIcon>PLC-RabbitMQ.png</PackageIcon>
    <Version>3.1.0</Version>
    <Description>A AutoConfigure RabbitMQ library for ASP.NET applications</Description>
    <PackageProjectUrl>https://github.com/phuocleoceo/plc-asp-rabbit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/phuocleoceo/plc-asp-rabbit</RepositoryUrl>
    <!--        <Nullable>enable</Nullable>-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="PLC-RabbitMQ.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
</Project>
